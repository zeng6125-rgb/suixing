+package com.suixing.agent.ui.components
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * [MarkdownCache] 改「增量前缀」前后的**逐块等价**：边界形状逐一与旧实现对拍。
+ *
+ * 为什么拿旧实现当答案、而不是 `parseMarkdown`：这条缓存只负责「复用已定稿的前缀、只解析尾巴」，
+ * 它该输出什么由旧实现定义 —— 新实现与旧实现同输出，才是纯粹的**性能**改动。与一次性解析相等
+ * 是另一条不变式，`MarkdownCacheTest` 已经在守。
+ *
+ * 覆盖的形状：空串、全是反引号、前缀正好落在行边界、文本变短 / 换块 / 重放。
+ */
+class MarkdownPrefixEdgeTest {
+
+    /** 改动前的 `MarkdownCache`，原样留在这里当参照物（**不要跟着改**）。 */
+    private class LegacyCache {
+        private var text = ""
+        private var prefix = ""
+        private var prefixBlocks: List<MdBlock> = emptyList()
+        private var blocks: List<MdBlock> = emptyList()
+
+        fun blocksFor(next: String): List<MdBlock> {
+            if (next == text) return blocks
+            val settled = settledPrefix(next)
+            if (settled.isNotEmpty() && settled == prefix) {
+                blocks = prefixBlocks + parseMarkdown(next.removePrefix(settled))
+            } else {
+                prefixBlocks = if (settled.isEmpty()) emptyList() else parseMarkdown(settled)
+                blocks = if (settled.isEmpty()) {
+                    parseMarkdown(next)
+                } else {
+                    prefixBlocks + parseMarkdown(next.removePrefix(settled))
+                }
+                prefix = settled
+            }
+            text = next
+            return blocks
+        }
+
+        private fun settledPrefix(text: String): String {
+            var searchFrom = text.length
+            while (true) {
+                val at = text.lastIndexOf("\n\n", searchFrom - 1)
+                if (at < 0) return ""
+                val candidate = text.substring(0, at + 2)
+                if (candidate.count { it == '`' } % 2 == 0) return candidate
+                searchFrom = at
+            }
+        }
+    }
+
+    /** 同一串输入按顺序喂给两个实现，**每一步**的输出都必须相等（状态机是跨步的）。 */
+    private fun assertSameAsLegacy(steps: List<String>) {
+        val legacy = LegacyCache()
+        val cache = MarkdownCache()
+        for ((i, step) in steps.withIndex()) {
+            assertEquals(
+                "第 $i 步（长度 ${step.length}）与改动前不一致",
+                legacy.blocksFor(step),
+                cache.blocksFor(step),
+            )
+        }
+    }
+
+    /** 逐字符喂一段文本：每一步都是上一步的前缀，走的是增量分支。 */
+    private fun feedCharByChar(text: String) =
+        (0..text.length).map { text.substring(0, it) }
+
+    @Test
+    fun `an empty text and the first characters`() {
+        assertSameAsLegacy(listOf("", "", "a", "a\n", "\n\n", ""))
+    }
+
+    @Test
+    fun `a text made only of backticks`() {
+        // 奇偶判据就是"数下来的反引号是偶数吗"，这里让每个候选前缀的奇偶一路交错。
+        assertSameAsLegacy(feedCharByChar("``\n\n```\n\n````\n\n`````"))
+    }
+
+    @Test
+    fun `a prefix landing exactly on a line boundary`() {
+        assertSameAsLegacy(
+            listOf("一\n\n二\n\n三", "一\n\n二\n\n三\n", "一\n\n二\n\n三\n\n"),
+        )
+    }
+
+    @Test
+    fun `a shorter or replaced text rebuilds`() {
+        assertSameAsLegacy(
+            listOf(
+                "第一段\n\n第二段\n\n第三段",
+                "第一段\n\n第二段", // 变短：旧前缀比新文本还长
+                "另一段\n\n再来一段", // 换块：不是前缀
+                "第一段\n\n第二段\n\n第三段", // 重放：再长回去
+            ),
+        )
+    }
+
+    @Test
+    fun `every prefix of a mixed text matches`() {
+        // 正文里夹着成对的与**未闭合**的行内反引号（后者只让判据更保守，不该改变输出）。
+        assertSameAsLegacy(feedCharByChar("有 `code` 的一段。\n\n```kotlin\nval a = 1\n\nval b = 2\n```\n\n`未闭合"))
+    }
+}
