<?xml version="1.0" encoding="utf-8"?>
<!-- The drawer handle: three round-capped bars, softer than the material glyph the
     user kept rejecting. The fill is black on purpose; the tint on the Icon side is
     what colours it.

     Drawn on a 22 viewport because every call site renders it at 22dp, so one unit is
     one dp: each bar is a 13-unit line plus a 1.25-unit cap at either end — 15.5dp
     wide — and 2.5dp thick, the three centres 5.5dp apart for a 3dp gap, 13.5dp tall
     in all and centred in the box. The weight is 2.5dp because the user compared the
     button against his reference and called the old 2dp bars thin. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="22"
    android:viewportHeight="22"
    android:tint="#FF000000">
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.5,5.5 L17.5,5.5"
        android:strokeWidth="2.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.5,11 L17.5,11"
        android:strokeWidth="2.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.5,16.5 L17.5,16.5"
        android:strokeWidth="2.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
</vector>
