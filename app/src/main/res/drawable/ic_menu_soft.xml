<?xml version="1.0" encoding="utf-8"?>
<!-- The drawer handle: three round-capped bars, softer than the material glyph the
     user kept rejecting. The fill is black on purpose; the tint on the Icon side is
     what colours it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FF000000">
    <path
        android:fillColor="#FF000000"
        android:pathData="M4,7.5 L20,7.5"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M4,12.5 L20,12.5"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M4,17.5 L20,17.5"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
</vector>
