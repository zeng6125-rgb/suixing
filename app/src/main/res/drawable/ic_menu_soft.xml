<?xml version="1.0" encoding="utf-8"?>
<!-- The drawer handle: three round-capped bars, softer than the material glyph the
     user kept rejecting. The fill is black on purpose; the tint on the Icon side is
     what colours it.

     Drawn on a 22 viewport because every call site renders it at 22dp, so one unit is
     one dp: each bar is a 13-unit line plus a 1-unit cap at either end — 15dp wide —
     and 2dp thick, the three centres 5dp apart for a 3dp gap, 12dp tall in all and
     centred in the box. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="22"
    android:viewportHeight="22"
    android:tint="#FF000000">
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.5,6 L17.5,6"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.5,11 L17.5,11"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.5,16 L17.5,16"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
</vector>
