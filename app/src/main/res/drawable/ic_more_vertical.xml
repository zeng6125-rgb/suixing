    <path
        android:fillColor="#FF000000"
        android:pathData="M11,5.5 L11,5.5"
        android:strokeWidth="2.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M11,11 L11,11"
        android:strokeWidth="2.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M11,16.5 L11,16.5"
