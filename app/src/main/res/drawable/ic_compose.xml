<?xml version="1.0" encoding="utf-8"?>
<!-- A new conversation: a rounded square with a pencil leaning out of its top-right
     corner, the compose glyph the reference app uses. Tint-controlled like its twin. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FF000000">
    <!-- The rounded square, open where the pencil crosses it. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M19,13.5 L19,17 A3,3 0 0 1 16,20 L7,20 A3,3 0 0 1 4,17 L4,8 A3,3 0 0 1 7,5 L10.5,5"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- The pencil: shaft past the corner, tip into the square. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M18.5,3.5 L21,6 L12.5,14.5 L9.5,15 L10,12 Z"
        android:strokeWidth="2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
