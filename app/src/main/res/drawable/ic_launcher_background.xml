<?xml version="1.0" encoding="utf-8"?>
<!-- 图标底：墨绿深→浅的对角渐变，深色在上、浅色在下，白羽压在浅的那头才亮得起来。
     自适应图标允许 background 层用 drawable，所以这里不必退化成一个纯色。

     渐变两端都取自品牌色的暗端（#0E2A1F → #245E45）：图标底要比界面里的 primary
     更暗，否则白羽在浅色启动器上会糊成一片。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="0"
                android:endX="90"
                android:endY="108">
                <item android:offset="0" android:color="#FF0E2A1F" />
                <item android:offset="1" android:color="#FF245E45" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
