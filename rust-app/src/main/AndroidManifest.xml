<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <application
        android:name="com.suixing.agent.rust.platform.RustApplication"
        android:label="${jagentLabel}"
        android:hasCode="true"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/rust_backup_rules"
        android:dataExtractionRules="@xml/rust_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/rust_network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service
            android:name="${jagentAgentService}"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="${jagentSchedulerService}"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user-scheduled assistant tasks with visible progress, cancellation, and deferred manual execution" />
        </service>
        <service
            android:name="${jagentTerminalService}"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user-started interactive PTY terminal sessions with visible progress and stop action" />
        </service>
        <service android:name="com.suixing.agent.rust.platform.RustJobService"
            android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user-started background commands with persistent logs, visible progress, and stop controls" />
        </service>
        <service android:name="${jagentFloatConsoleService}"
            android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user-enabled floating task controls with exact stop and conversational input while the app is backgrounded" />
        </service>
        <service android:name="com.suixing.agent.rust.platform.RustSpeechService"
            android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name="com.suixing.agent.rust.platform.RustLinuxService"
            android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name="${jagentAccessibilityService}"
            android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/rust_accessibility_service" />
        </service>
        <provider android:name="com.suixing.agent.rust.platform.RustFileProvider"
            android:authorities="${applicationId}.rustfiles;${applicationId}.filedelivery" android:exported="false"
            android:grantUriPermissions="true" />
        <provider android:name="com.suixing.agent.rust.platform.RustShizukuProvider"
            android:authorities="${applicationId}.shizuku" android:exported="true"
            android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name="${jagentVirtualScreenActivity}"
            android:exported="false" android:allowEmbedded="true" android:excludeFromRecents="true"
            android:taskAffinity="com.suixing.agent.rust.virtualscreen" />
        <receiver android:name="com.suixing.agent.rust.platform.RustScheduleReceiver" android:exported="false" />
        <receiver android:name="${jagentBootReceiver}" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity
            android:name="com.suixing.agent.rust.platform.RustNativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="suixing_rust_app" />
        </activity>
        <activity-alias android:name="${jagentLauncher}"
            android:targetActivity="com.suixing.agent.rust.platform.RustNativeActivity"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="suixing_rust_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>
</manifest>
