<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The original app keeps user content off cloud backups. Rust generations
         may contain archived source documents, so exclude the entire file domain. -->
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="linux" />
        <exclude domain="file" path="toolout" />
        <exclude domain="file" path="rust-state/linux-operations" />
        <exclude domain="file" path="rust-state/toolout" />
    </device-transfer>
</data-extraction-rules>
